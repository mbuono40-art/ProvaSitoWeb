# Modello di configurazione.
# Copiare in ".env.local" (ignorato da Git) e valorizzare le voci necessarie.

# --- Account di direzione ------------------------------------------------
# Usati solo alla creazione dell'account, al primo avvio su un database
# vuoto. Se ADMIN_PASSWORD non è valorizzata ne viene generata una casuale,
# mostrata una sola volta nel log del server.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Database ------------------------------------------------------------
# Senza queste variabili l'applicazione usa un file SQLite locale in data/.
# Valorizzarle per collegarsi a un database SQLite gestito (libSQL/Turso),
# necessario in ambienti con filesystem non persistente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Catalogo esterno (facoltativo) --------------------------------------
# Abilita l'importazione di schede film da TMDb dal pannello di direzione.
# Sono accettate sia la chiave API v3 sia il token v4.
TMDB_API_KEY=
