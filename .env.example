# Copia questo file in ".env.local" e modifica i valori.
# .env.local NON viene mai caricato su GitHub.

# --- Amministratore creato al primo avvio -------------------------------
# Se cambi questi valori PRIMA del primo avvio, l'admin nasce già con essi.
# Se li cambi dopo, l'account esistente resta invariato.
ADMIN_EMAIL=admin@cinemaaureo.it
ADMIN_PASSWORD=aureo2026

# --- Database ------------------------------------------------------------
# In locale non serve toccare nulla: senza queste due righe il sito usa un
# file SQLite dentro data/cinema.db, creato automaticamente.
# Per pubblicare il sito online (es. su Vercel) serve un database Turso
# (gratuito): crealo su turso.tech, poi incolla qui URL e token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- TMDb (facoltativo) -------------------------------------------------
# Serve solo per importare film con locandine reali dal pannello admin.
# Chiave gratuita: themoviedb.org -> Impostazioni -> API
# Funzionano sia la chiave v3 sia il token v4.
TMDB_API_KEY=
