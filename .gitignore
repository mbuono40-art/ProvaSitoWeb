# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database locale del cinema (creato al primo avvio)
/data

# immagini caricate dall'admin (locandine e sfondi)
/public/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# file di istruzioni per assistenti AI (rigenerati da next dev, non vanno pubblicati)
CLAUDE.md
AGENTS.md
